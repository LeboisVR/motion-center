/**
  * @brief  TIM2 – free-running 1 MHz counter (polled, no IRQ).
  *         HSE 8 MHz x PLLMUL9 = SYSCLK 72 MHz. APB1 = HCLK/2 = 36 MHz, mais
  *         le prescaler APB1 != 1 double l'horloge timer -> TIM2 clock = 72 MHz.
  *         PSC=71 -> tick = 72 MHz / 72 = 1 MHz (1 µs) exact.
  *         ARR=0xFFFF -> compteur 16 bits, wrap a 65535 µs.
  *         (Avant : PSC=47 donnait 1,5 MHz -> delay_us ~1,5x trop court.)
  */
static void MX_TIM2_Init(void)
{
  __HAL_RCC_TIM2_CLK_ENABLE();
  TIM2->PSC  = 71U;       /* 72 MHz / 72 = 1 MHz tick (1 µs) */
  TIM2->ARR  = 0xFFFFU;
  TIM2->CNT  = 0U;
  TIM2->EGR  = TIM_EGR_UG;
  TIM2->SR   = 0U;
  TIM2->DIER = 0U;        /* no interrupt */
  TIM2->CR1  = TIM_CR1_CEN;
}

static void delay_us(uint16_t us)
{
  uint16_t start = (uint16_t)TIM2->CNT;
  while ((uint16_t)((uint16_t)TIM2->CNT - start) < us) { }
}

/* Base de temps µs pour le module Actuator (axStep / homing).
   TIM2 est un compteur 16 bits a 1 µs (PSC=71) ; on l'etend en 32 bits par
   suivi du wrap. Surcharge le symbole faible defini dans Actuator.cpp.
   IMPORTANT : doit etre appele regulierement (< 65 ms) pour ne pas manquer
   de wrap -> appel ajoute en tete de boucle principale. Sur de l'ecart
   (delta), pas absolu : un trou (ex. HAL_Delay) ne fausse qu'un seul calcul. */
static volatile uint32_t s_usHigh = 0U;
static volatile uint16_t s_usLast = 0U;
uint32_t axMicros(void)
{
  uint16_t now = (uint16_t)TIM2->CNT;
  if (now < s_usLast) s_usHigh += 0x10000UL;   /* TIM2 a reboucle */
  s_usLast = now;
  return s_usHigh + now;
}

/* Initialise le modele verin partage pour cette box F103 (4 axes servo).
   Pas d'endstop cable ici -> homing desactive ; valeurs pretes pour un futur
   homing (passer hasEndstop=true et hastobehomed=true le moment venu). */
static void actuatorConfigInit(void)
{
  /* M1-M4 : servos A6-RS, position absolue, pas de homing firmware. */
  for (uint8_t i = 0; i < 4U; i++) {
    axCfg[i].maxPos          = 32767U;  /* plage logique SimHub (0..32767) */
    axCfg[i].margin          = 0U;
    axCfg[i].dir             = (int8_t)+1;  /* donnee seule : non appliquee par le moteur de pas */
    axCfg[i].connected       = true;
    axCfg[i].hasEndstop      = false;
    axCfg[i].hastobehomed    = false;
    axCfg[i].absoluteEncoder = true;
    axCfg[i].hometoMax       = false;
    axCfg[i].endParkPosition = false;

    ax[i].calibrated = true;   /* coherent avec STATUS (cal=1) */
    ax[i].homed      = true;   /* position courante = reference 0 */
    ax[i].homing     = false;
    ax[i].hs         = HS_IDLE;
  }

  /* M5/M6 : steppers optionnels avec endstop cable -> homing/calibration
     comme sur l'ATmega32U4. max/margin charges depuis la NVM si le schema
     est valide (sinon defauts non calibres). */
  const bool nvmValid =
      (hwEepromReadU16(EEPROM_HAS_BEEN_FACTORYRESET) == EEPROM_SCHEMA_VERSION);
  static const uint16_t maxAddr[2]    = { EEPROM_M5MAX_ADDR,    EEPROM_M6MAX_ADDR    };
  static const uint16_t marginAddr[2] = { EEPROM_M5MARGIN_ADDR, EEPROM_M6MARGIN_ADDR };
  static const uint16_t connAddr[2]   = { EEPROM_M5CONNECTED_ADDR, EEPROM_M6CONNECTED_ADDR };
  for (uint8_t k = 0; k < 2U; k++) {
    const uint8_t i = (uint8_t)(4U + k);
    if (i >= NUM_MOTORS) break;
    const uint16_t m  = nvmValid ? hwEepromReadU16(maxAddr[k])    : 0U;
    const uint16_t mg = nvmValid ? hwEepromReadU16(marginAddr[k]) : 0U;
    /* Defaut AVR (Globals.cpp) : M5+ deconnectes tant que l'utilisateur
       ne les active pas dans Motion Center. */
    const bool     cn = nvmValid ? (hwEepromReadU16(connAddr[k]) != 0U) : false;

    axCfg[i].maxPos          = m;
    axCfg[i].margin          = mg;
    axCfg[i].dir             = (int8_t)+1;
    axCfg[i].connected       = cn;
    axCfg[i].hasEndstop      = true;    /* M5ENDSTOP / M6ENDSTOP cables */
    axCfg[i].hastobehomed    = true;
    axCfg[i].absoluteEncoder = false;
    axCfg[i].hometoMax       = false;
    axCfg[i].endParkPosition = false;

    ax[i].calibrated = (m != 0U);
    ax[i].homed      = false;   /* zero inconnu tant que pas home */
    ax[i].homing     = false;
    ax[i].hs         = HS_IDLE;
  }

  /* Vitesse de homing persistee (defaut FSM = ~333 sps si invalide). */
  if (nvmValid) {
    uint16_t sps = hwEepromReadU16(EEPROM_HOMINGSPS_ADDR);
    if (sps >= 50U && sps <= 10000U) {
      homingSetSpeed((1000000UL + sps / 2U) / sps, 1U);
    }
  }
}

/**
  * @brief  Génération step/dir – appelée depuis le main loop (pas d'ISR).
  *         DIR et STEP sont décidés sur un SEUL instantané (même 'now') : tout
  *         moteur effectivement impulsé a donc sa broche DIR posée avec le temps
  *         de setup respecté, y compris lors d'une inversion de sens. Cela
  *         supprime le risque d'un pas émis avec une direction périmée.
  *         Pulse HIGH = PULSE_HIGH_US, setup DIR = DIRECTION_DELAY_US.
  */
/* Largeurs en µs RÉELLES depuis le correctif PSC=71 (TIM2 = 1 MHz exact).
   Avant : TIM2 tournait à 1,5 MHz -> ces durées étaient ~1,5x plus courtes.
   Valeurs sûres pour un drive step/dir type A6-RS ; ajustables si besoin. */
#define DIRECTION_DELAY_US  8U
#define PULSE_HIGH_US       5U
#define PULSE_LOW_US        3U
#define MIN_INTER_STEP_US  2U

static void stepDirServiceFastV2(void)
{
  if (!servoEnabled) return;
  if ((int32_t)(HAL_GetTick() - servoMotionAllowedAt) < 0) return;

  uint16_t * const lastStepUs = s_lastStepUs;
  int8_t   * const dirV       = s_dirV;

  /* Instantané unique : sert à la fois pour la décision DIR et STEP. */
  uint16_t now = (uint16_t)TIM2->CNT;

  uint16_t stepMask  = 0;
  bool     dirChanged = false;

  /* Pass 1 : sélectionner les moteurs à impulser MAINTENANT et poser leur DIR.
     Le même critère gouverne DIR et STEP → pas de moteur impulsé sans DIR. */
  for (uint8_t i = 0; i < NUM_MOTORS; i++)
  {
    if (ax[i].pos == ax[i].target) continue;
    if ((uint16_t)(now - lastStepUs[i]) < MIN_INTER_STEP_US) continue;

    int8_t nd = (ax[i].target > ax[i].pos) ? 1 : -1;
    if (nd < 0 && ax[i].pos == 0U) { ax[i].target = 0U; continue; }

    if (nd != dirV[i])
    {
      dirV[i] = nd;
      if (nd > 0)
        GPIOB->BRR  = DIR_PIN[i];
      else
        GPIOB->BSRR = DIR_PIN[i];
      dirChanged = true;
    }

    stepMask |= STEP_PIN[i];
  }

  if (stepMask == 0) return;

  /* Respecter le temps de setup DIR avant le front STEP. */
  if (dirChanged) delay_us(DIRECTION_DELAY_US);

  /* Pulse simultané. */
  GPIOA->BSRR = stepMask;
  delay_us(PULSE_HIGH_US);
  GPIOA->BRR  = stepMask;
  delay_us(PULSE_LOW_US);

  /* Pass 2 : mise à jour positions + horodatages. */
  uint16_t newNow = (uint16_t)TIM2->CNT;
  for (uint8_t i = 0; i < NUM_MOTORS; i++)
  {
    if (!(stepMask & STEP_PIN[i])) continue;
    if (dirV[i] > 0) ax[i].pos++;
    else             ax[i].pos--;
    lastStepUs[i] = newNow;
  }
}

/* ==========================================================================
 *  Protocole texte Motion Center (coexiste avec le binaire SimHub)
 * ========================================================================== */

/* Envoi d'une chaîne ASCII sur l'USB CDC.
   CRITIQUE : CDC_Transmit_FS ne COPIE PAS le buffer — il memorise le
   pointeur, et les paquets de continuation (>64 octets) sont lus depuis ce
   buffer PLUS TARD, dans l'IRQ USB. Transmettre un buffer de pile corrompt
   donc toute reponse multi-paquets (ex: ligne STATUS tronquee apres 64
   octets). On copie dans un buffer statique, et on attend la fin du
   transfert precedent avant de le reutiliser. */
static uint8_t s_cdcTxBuf[192];
static void cdc_send_str(const char *s)
{
  uint16_t n = (uint16_t)strlen(s);
  if (n == 0U) return;
  if (n > (uint16_t)sizeof(s_cdcTxBuf)) n = (uint16_t)sizeof(s_cdcTxBuf);

  /* Attendre que l'IRQ USB ait fini de lire s_cdcTxBuf (50 ms max). */
  USBD_CDC_HandleTypeDef *hcdc =
      (USBD_CDC_HandleTypeDef *)hUsbDeviceFS.pClassData;
  if (hcdc == NULL) return;                  /* USB pas encore enumere */
  for (uint16_t k = 0; (k < 500U) && (hcdc->TxState != 0U); k++)
    delay_us(100U);
  if (hcdc->TxState != 0U) return;           /* lien mort : on jette */

  memcpy(s_cdcTxBuf, s, n);
  for (uint16_t k = 0; k < 64U; k++)
  {
    if (CDC_Transmit_FS(s_cdcTxBuf, n) == USBD_OK) return;
    delay_us(200U);
  }
}

static void txtToUpper(char *s)
{
  for (; *s; ++s)
    if (*s >= 'a' && *s <= 'z') *s = (char)(*s - 32);
}

static bool txtEq(const char *a, const char *b)
{
  while (*a && *b) { if (*a != *b) return false; ++a; ++b; }
  return (*a == '\0' && *b == '\0');
}

/* Ligne STATUS compatible Motion Center (préfixe "STATUS ").
   Cette box a 4 axes, sans EEPROM/calibration : conn=1, cal=1, max=32767. */
static void sendStatusLine(void)
{
  /* Cette box n'a ni EEPROM ni calibration : conn=1, cal=1, max=32767.
     Version et nombre d'axes proviennent de boxCfg (Actuator.h). */
  static char line[192];   /* statique : pile 1KB du F103 + coherence TX */
  int off = snprintf(line, sizeof(line),
                     "STATUS FW=2.1 BOX=%u SERVO=%c",
                     (unsigned)boxCfg.version,
                     servoEnabled ? '1' : '0');
  if (off < 0) return;
  for (uint8_t i = 0; i < NUM_MOTORS && off < (int)sizeof(line); i++) {
    int w;
    if (i < 4U) {
      w = snprintf(line + off, sizeof(line) - (size_t)off,
                   " M%u=1,1,32767,0", (unsigned)(i + 1));
    } else {       /* M5/M6 : etat reel conn,cal,max,margin */
      w = snprintf(line + off, sizeof(line) - (size_t)off,
                   " M%u=%u,%u,%u,%u", (unsigned)(i + 1),
                   axCfg[i].connected ? 1U : 0U,
                   ax[i].calibrated   ? 1U : 0U,
                   (unsigned)axCfg[i].maxPos,
                   (unsigned)axCfg[i].margin);
    }
    if (w < 0) break;
    off += w;
  }
  if (off < (int)sizeof(line) - 1) { line[off++] = '\n'; line[off] = '\0'; }
  cdc_send_str(line);
}

/* Passage en mode DFU : saut au bootloader système STM32 (0x1FFFF000).
   Les drives sont d'abord coupés par sécurité. Ne revient jamais. */
static void enterDFU(void)
{
  /* Sécurité : relâcher relais + drives avant de quitter le firmware. */
  disableServo();

  __HAL_RCC_PWR_CLK_ENABLE();
  __HAL_RCC_BKP_CLK_ENABLE();
  HAL_PWR_EnableBkUpAccess();
  BKP->DR1 = 0x4F50U;        /* BKP_FORCE_MAGIC — doit matcher iap.c */

  NVIC_SystemReset();        /* reset à froid → bootloader → mode update */
  while (1) { }
}

/* ==========================================================================
 *  Commandes de calibration M5/M6 (protocole identique a l'AVR v1.8)
 * ========================================================================== */

/* Tokenisation in-place : retourne le token courant, avance *cur. */
static char* nextTok(char **cur)
{
  char *s = *cur;
  while (*s == ' ' || *s == '\t') s++;
  if (*s == '\0') { *cur = s; return NULL; }
  char *tok = s;
  while (*s && *s != ' ' && *s != '\t') s++;
  if (*s) { *s = '\0'; s++; }
  *cur = s;
  return tok;
}

static bool parseU32(const char *s, uint32_t *out)
{
  if (!s || !*s) return false;
  uint32_t v = 0;
  for (; *s; s++) {
    if (*s < '0' || *s > '9') return false;
    if (v > 429496728UL) return false;        /* overflow guard */
    v = v * 10UL + (uint32_t)(*s - '0');
  }
  *out = v;
  return true;
}

/* Persiste max+margin d'un axe optionnel (motor = 5 ou 6). */
static void saveCalibration(uint8_t motor)
{
  if (motor != 5U && motor != 6U) return;
  const uint8_t idx = (uint8_t)(motor - 1U);
  const uint16_t aMax = (motor == 5U) ? EEPROM_M5MAX_ADDR    : EEPROM_M6MAX_ADDR;
  const uint16_t aMar = (motor == 5U) ? EEPROM_M5MARGIN_ADDR : EEPROM_M6MARGIN_ADDR;
  hwEepromWriteU16(aMax, axCfg[idx].maxPos);
  hwEepromWriteU16(aMar, axCfg[idx].margin);
  /* Premiere ecriture sur flash vierge : poser le marqueur de schema. */
  if (hwEepromReadU16(EEPROM_HAS_BEEN_FACTORYRESET) != EEPROM_SCHEMA_VERSION)
    hwEepromWriteU16(EEPROM_HAS_BEEN_FACTORYRESET, EEPROM_SCHEMA_VERSION);
}

/* Reponse differee : OK/ERR quand la sequence de calibration se termine.
   A appeler dans la boucle principale. */
static void serviceCalibReply(void)
{
  if (s_calOp == CALOP_NONE) return;

  for (uint8_t i = 4; i < NUM_MOTORS; i++) {
    if (!(s_calMask & (1u << i))) continue;
    if (s_calOp == CALOP_DETECT_MIN) {
      if (ax[i].homing) return;               /* encore en cours */
    } else {
      if (calibIsBusy(i)) return;             /* encore en cours */
    }
  }

  /* Tout est termine : verdict global. */
  bool ok = true;
  for (uint8_t i = 4; i < NUM_MOTORS; i++) {
    if (!(s_calMask & (1u << i))) continue;
    if (s_calOp == CALOP_DETECT_MIN) {
      ok = ok && ax[i].homed && (ax[i].hs != HS_ERROR);
    } else {
      ok = ok && (calibGetState(i) == CAL_DONE);
      if (calibGetState(i) == CAL_DONE) saveCalibration((uint8_t)(i + 1U));
      calibAckResult(i);
    }
  }
  cdc_send_str(ok ? "OK\n" : "ERR CALIB_FAILED\n");
  s_calOp   = CALOP_NONE;
  s_calMask = 0;
}

/* SET <KEY> <VALUE> [MOTOR] — sous-ensemble M5/M6 du protocole AVR. */
static void handleSet(char *cursor)
{
  char *key = nextTok(&cursor);
  char *val = nextTok(&cursor);
  char *mot = nextTok(&cursor);
  if (!key || !val) { cdc_send_str("ERR BAD_ARGS\n"); return; }

  uint32_t v32 = 0;
  if (!parseU32(val, &v32)) { cdc_send_str("ERR BAD_VALUE\n"); return; }
  if (v32 > 65535UL) v32 = 65535UL;

  if (txtEq(key, "HOMING_S")) {
    uint32_t sps = v32;
    if (sps < 50UL)    sps = 50UL;
    if (sps > 10000UL) sps = 10000UL;
    cdc_send_str("OK\n");                  /* repondre AVANT l'ecriture flash */
    homingSetSpeed((1000000UL + sps / 2UL) / sps, 1U);
    hwEepromWriteU16(EEPROM_HOMINGSPS_ADDR, (uint16_t)sps);
    return;
  }

  uint32_t motor = 0;
  if (!mot || !parseU32(mot, &motor) || motor < 1U || motor > 6U) {
    cdc_send_str("ERR BAD_MOTOR\n");
    return;
  }
  const uint8_t idx = (uint8_t)(motor - 1U);

  /* CONNECTED : accepte M1-M6 comme l'AVR. M1-M4 sont cables en dur sur
     cette box -> no-op OK (pas d'ERR, sinon l'UI se desynchronise). */
  if (txtEq(key, "CONNECTED")) {
    cdc_send_str("OK\n");          /* repondre AVANT l'ecriture flash (regle AVR) */
    if (motor >= 5U) {
      axCfg[idx].connected = (v32 != 0UL);
      if (v32 == 0UL) { ax[idx].homed = false; ax[idx].target = ax[idx].pos; }
      hwEepromWriteU16((motor == 5U) ? EEPROM_M5CONNECTED_ADDR
                                     : EEPROM_M6CONNECTED_ADDR,
                       (v32 != 0UL) ? 1U : 0U);
      if (hwEepromReadU16(EEPROM_HAS_BEEN_FACTORYRESET) != EEPROM_SCHEMA_VERSION)
        hwEepromWriteU16(EEPROM_HAS_BEEN_FACTORYRESET, EEPROM_SCHEMA_VERSION);
    }
    return;
  }

  /* MAX / MARGIN : geres uniquement pour les axes optionnels (regle AVR
     MARGIN_ONLY_M5_M6 ; M1-M4 ont un max virtuel fixe sur cette box). */
  if (motor < 5U) { cdc_send_str("ERR ONLY_M5_M6\n"); return; }

  if (txtEq(key, "MAX")) {
    cdc_send_str("OK\n");          /* repondre AVANT l'ecriture flash */
    axCfg[idx].maxPos = (uint16_t)v32;
    ax[idx].calibrated = (v32 != 0UL);
    saveCalibration((uint8_t)motor);
    return;
  }
  if (txtEq(key, "MARGIN")) {
    cdc_send_str("OK\n");          /* repondre AVANT l'ecriture flash */
    axCfg[idx].margin = (uint16_t)v32;
    saveCalibration((uint8_t)motor);
    return;
  }
  cdc_send_str("ERR UNKNOWN_KEY\n");
}

/* autoConnectIfNeeded (regle AVR) : une commande de calibration sur un axe
   non connecte le connecte implicitement et persiste. */
static void autoConnectIfNeeded(uint8_t motor)
{
  if (motor != 5U && motor != 6U) return;
  const uint8_t idx = (uint8_t)(motor - 1U);
  if (axCfg[idx].connected) return;
  axCfg[idx].connected = true;
  hwEepromWriteU16((motor == 5U) ? EEPROM_M5CONNECTED_ADDR
                                 : EEPROM_M6CONNECTED_ADDR, 1U);
  if (hwEepromReadU16(EEPROM_HAS_BEEN_FACTORYRESET) != EEPROM_SCHEMA_VERSION)
    hwEepromWriteU16(EEPROM_HAS_BEEN_FACTORYRESET, EEPROM_SCHEMA_VERSION);
}

/* DO <ACTION> [MOTOR] — actions de calibration M5/M6 (protocole AVR). */
static void handleDo(char *cursor)
{
  char *act = nextTok(&cursor);
  char *mot = nextTok(&cursor);
  if (!act) { cdc_send_str("ERR BAD_ARGS\n"); return; }

  uint32_t motor = 0;
  if (mot && !parseU32(mot, &motor)) { cdc_send_str("ERR BAD_MOTOR\n"); return; }

  if (txtEq(act, "CANCEL")) {
    homingAbortRequest();                    /* traite au prochain homingTick() */
    if (s_calOp != CALOP_NONE) {             /* clore la commande en attente */
      s_calOp = CALOP_NONE; s_calMask = 0;
    }
    cdc_send_str("OK\n");
    return;
  }

  if (txtEq(act, "DETECT_MIN")) {
    if (motor != 0U && motor != 5U && motor != 6U) { cdc_send_str("ERR ONLY_M5_M6\n"); return; }
    if (s_calOp != CALOP_NONE) { cdc_send_str("ERR BUSY\n"); return; }
    if (motor == 5U || motor == 6U) autoConnectIfNeeded((uint8_t)motor);
    uint8_t mask = 0;
    if ((motor == 5U || motor == 0U) && axCfg[4].connected) { ax[4].homed = false; mask |= (1u << 4); }
    if ((motor == 6U || motor == 0U) && NUM_MOTORS > 5 && axCfg[5].connected) { ax[5].homed = false; mask |= (1u << 5); }
    if (!mask) { cdc_send_str("ERR NOT_CONNECTED\n"); return; }
    if (!servoEnabled) enableServo();
    homingStart(mask);
    s_calOp = CALOP_DETECT_MIN; s_calMask = mask;   /* OK/ERR a la fin */
    return;
  }

  if (txtEq(act, "DETECT_MAX") || txtEq(act, "MOVE_TO_MAX")) {
    if (motor != 5U && motor != 6U) { cdc_send_str("ERR ONLY_M5_M6\n"); return; }
    if (s_calOp != CALOP_NONE) { cdc_send_str("ERR BUSY\n"); return; }
    const uint8_t idx = (uint8_t)(motor - 1U);
    autoConnectIfNeeded((uint8_t)motor);
    if (!ax[idx].homed) { cdc_send_str("ERR NOT_HOMED\n"); return; }
    if (!servoEnabled) enableServo();
    calibStartDetectMax(idx);
    s_calOp = CALOP_CALIB; s_calMask = (uint8_t)(1u << idx);
    return;
  }

  if (txtEq(act, "FULL_CALIB") || txtEq(act, "COMPLETE_CALIB")) {
    if (motor != 5U && motor != 6U) { cdc_send_str("ERR ONLY_M5_M6\n"); return; }
    if (s_calOp != CALOP_NONE) { cdc_send_str("ERR BUSY\n"); return; }
    const uint8_t idx = (uint8_t)(motor - 1U);
    autoConnectIfNeeded((uint8_t)motor);
    if (!servoEnabled) enableServo();
    calibStartFull(idx);
    s_calOp = CALOP_CALIB; s_calMask = (uint8_t)(1u << idx);
    return;
  }

  if (txtEq(act, "SERVO_ON"))  { enableServo();  cdc_send_str("OK\n"); return; }
  if (txtEq(act, "SERVO_OFF")) {
    homingCancel(); calibCancel();
    s_calOp = CALOP_NONE; s_calMask = 0;
    disableServo();
    cdc_send_str("OK\n");
    return;
  }

  cdc_send_str("ERR UNKNOWN_ACTION\n");
}

/* Dispatch d'une ligne de commande texte (terminée, sans \n). */
static void handleTextCommand(const char *line)
{
  char buf[48];

  /* Copie locale + trim gauche. */
  uint8_t i = 0;
  while (line[i] == ' ' || line[i] == '\t') i++;
  uint8_t j = 0;
  while (line[i] && j < (uint8_t)(sizeof(buf) - 1U)) buf[j++] = line[i++];
  /* Trim droite. */
  while (j > 0U && (buf[j - 1] == ' ' || buf[j - 1] == '\t')) j--;
  buf[j] = '\0';
  if (j == 0U) return;

  txtToUpper(buf);

  /* --- Bootloader DFU : !DFU --------------------------------------------- */
  if (txtEq(buf, "!DFU")) {
    cdc_send_str("DFU\n");
    HAL_Delay(50);   /* laisser la réponse partir avant de détacher l'USB */
    enterDFU();      /* ne revient pas */
    return;
  }

  /* --- Handshake Motion Center ------------------------------------------ */
  if (txtEq(buf, "MC_START") || txtEq(buf, "HELLO")) {
    simhubConnected = true;
    hostConnected   = true;
    cdc_send_str("OK_MC_CONNECTED\n");
    return;
  }
  if (txtEq(buf, "MC_DISABLE")) {
    disableServo();
    cdc_send_str("OK_MC_DISABLED\n");
    return;
  }
  if (txtEq(buf, "MC_STOP") || txtEq(buf, "DISCONNECT")) {
    cdc_send_str("OK_MC_DISCONNECTED\n");
    return;
  }

  /* --- Handshake SimHub (variante texte) -------------------------------- */
  if (txtEq(buf, "SH_CONNECTED") || txtEq(buf, "SHCONNECTED") || txtEq(buf, "SH-CONNECTED")) {
    simhubConnected = true;
    hostConnected   = true;
    cdc_send_str("SHCONNECTED\n");
    return;
  }
  if (txtEq(buf, "SH_START")) {
    for (uint8_t k = 0; k < 4U; k++) {   /* M1-M4 seulement : M5/M6 gardent leur zero */
      ax[k].pos = 0U; ax[k].target = 0U; s_lastStepUs[k] = 0U; s_dirV[k] = 0;
    }
    simhubConnected = true;
    hostConnected   = true;
    enableServo();
    /* Regle cmdEnable AVR : homing auto des axes calibres non homes. */
    {
      uint8_t mask = 0;
      for (uint8_t i = 4; i < NUM_MOTORS; i++) {
        if (axCfg[i].connected && ax[i].calibrated && !ax[i].homed)
          mask |= (uint8_t)(1u << i);
      }
      if (mask) homingStart(mask);
    }
    cdc_send_str("CALIBRATED\n");
    return;
  }
  if (txtEq(buf, "SH_DISABLE")) {
    simhubConnected = false;
    hostConnected   = false;
    homingCancel(); calibCancel();
    disableServo();
    cdc_send_str("SH_DISABLED\n");
    return;
  }
  if (txtEq(buf, "SH_DOWN") || txtEq(buf, "SHDOWN") || txtEq(buf, "SH-DOWN")) {
    simhubConnected = false;
    hostConnected   = false;
    cdc_send_str("BOX_DOWN\n");
    return;
  }

  /* --- Contrôle générique ----------------------------------------------- */
  if (txtEq(buf, "ENABLE")) {
    enableServo();
    cdc_send_str("OK_ENABLED\n");
    return;
  }
  if (txtEq(buf, "DISABLE")) {
    disableServo();
    cdc_send_str("OK_DISABLED\n");
    return;
  }
  if (txtEq(buf, "GET")) {
    sendStatusLine();
    return;
  }

  /* --- Calibration M5/M6 : SET <KEY> <VAL> [MOTOR] / DO <ACTION> [MOTOR] -- */
  if (buf[0] == 'S' && buf[1] == 'E' && buf[2] == 'T' &&
      (buf[3] == ' ' || buf[3] == '\t')) { handleSet(&buf[4]); return; }
  if (buf[0] == 'D' && buf[1] == 'O' &&
      (buf[2] == ' ' || buf[2] == '\t')) { handleDo(&buf[3]); return; }

  cdc_send_str("ERR UNKNOWN_CMD\n");
}

/* USER CODE END 4 */

