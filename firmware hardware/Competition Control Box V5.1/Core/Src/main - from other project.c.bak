/* ---------- Stash helpers (called from main loop only) -------------------- */
static inline void stash_consume(uint16_t n)
{
  __disable_irq();
  if (n >= s_len) { s_len = 0; }
  else { memmove(s_stash, s_stash + n, s_len - n); s_len -= n; }
  __enable_irq();
}

static inline uint16_t be16(const uint8_t *p)
{
  return (uint16_t)((p[0] << 8) | p[1]);
}

/* ---------- GPIO pin masks for STEP (GPIOA) and DIR (GPIOB) outputs -------*/
/*  Motor index : 0..3 (S1-S4/D1-D4 servos) ; 4..5 (S5-S6/D5-D6 steppers M5/M6) */
static const uint16_t STEP_PIN[NUM_MOTORS] = { S1_Pin, S2_Pin, S3_Pin, S4_Pin, S5_Pin, S6_Pin };
static const uint16_t DIR_PIN [NUM_MOTORS] = { D1_Pin, D2_Pin, D3_Pin, D4_Pin, D5_Pin, D6_Pin };

/* -------------------------------------------------------------------------- */
void enableServo(){
  HAL_GPIO_WritePin(ENABLE_RELAY_GPIO_Port, ENABLE_RELAY_Pin, GPIO_PIN_SET);   /* PB12 HIGH – engage relay        */
  HAL_Delay(2000);                                                              /* attendre 1s que le relais soit stable */
  HAL_GPIO_WritePin(ENABLE_SERVO_GPIO_Port, ENABLE_SERVO_Pin, GPIO_PIN_RESET); /* PB14 LOW  – enable servo drives */
  HAL_GPIO_WritePin(LED_GPIO_Port, LED_Pin, GPIO_PIN_SET);                     /* PB11 HIGH – LED on              */
  servoEnabled = true;
  servoMotionAllowedAt = HAL_GetTick() + SERVO_SETTLE_MS;
}

void disableServo(){
  HAL_GPIO_WritePin(ENABLE_RELAY_GPIO_Port, ENABLE_RELAY_Pin, GPIO_PIN_RESET); /* PB12 LOW  – release relay       */
  HAL_GPIO_WritePin(ENABLE_SERVO_GPIO_Port, ENABLE_SERVO_Pin, GPIO_PIN_SET);   /* PB14 HIGH – disable servo drives */
  HAL_GPIO_WritePin(LED_GPIO_Port, LED_Pin, GPIO_PIN_RESET);                   /* PB11 LOW  – LED off             */
  servoEnabled = false;
  servoMotionAllowedAt = 0;
  /* Reset tracking so next session starts from a clean 0 reference.
     The physical motor is wherever it stopped – that becomes the new step 0. */
  for (uint8_t i = 0; i < NUM_MOTORS; i++) {
    ax[i].pos = 0U;
    ax[i].target   = 0U;
  }
}

/* ==========================================================================
 *  Endstops M5/M6 + hooks plateforme requis par Homing.c
 *  (memes signatures que HardwareAbstraction AVR)
 * ========================================================================== */

/* Lecture brute : switch actif bas (vers GND, pull-up materielle). */
static bool hwReadEndstop(uint8_t motor)
{
  if (motor == 5U) return HAL_GPIO_ReadPin(M5ENDSTOP_GPIO_Port, M5ENDSTOP_Pin) == GPIO_PIN_RESET;
  if (motor == 6U) return HAL_GPIO_ReadPin(M6ENDSTOP_GPIO_Port, M6ENDSTOP_Pin) == GPIO_PIN_RESET;
  return false;
}

/* Lecture filtree : blanking + vote majoritaire (copie du contrat AVR). */
bool hwReadEndstopStable(uint8_t motor, uint16_t blank_us, uint8_t samples, uint8_t need_on)
{
  if (blank_us) delay_us(blank_us);
  uint8_t on = 0;
  for (uint8_t i = 0; i < samples; ++i) {
    if (hwReadEndstop(motor)) ++on;
    delay_us(50U);
  }
  return (on >= need_on);
}

/* LED unique PB11 deja pilotee par enable/disableServo : on ne mappe pas
   les couleurs AVR ici (no-op), la LED reste l'indicateur servo. */
void hwLedSet(const char* color) { (void)color; }
void refreshConnectionLed(void)  { }

/* Logs homing/calibration -> Motion Center via USB CDC. */
void hwLog(const char* msg)
{
  cdc_send_str(msg);
  cdc_send_str("\n");
}

void SerialReaderP(void)
{
  /* Suivi d'inactivité : SimHub n'envoie aucun terminateur de ligne. */
  static uint16_t s_prevLen    = 0U;
  static uint32_t s_lastRxTick = 0U;
  if (s_len != s_prevLen) { s_prevLen = s_len; s_lastRxTick = HAL_GetTick(); }

  for (;;) {
    if (s_len == 0U) break;

    uint8_t c0 = s_stash[0];

    /* ===== Trames de cibles SimHub : 'P' + 6 axes × 2 octets (16 bits) === */
    if (c0 == 'P') {
      if (s_len >= 13U) {
        const uint8_t *payload = &s_stash[1];
        /* AxisResolution=16 (0..65535) → unités internes 0..32767 */
        ax[0].target = be16(&payload[0]) >> 1;
        ax[1].target = be16(&payload[2]) >> 1;
        ax[2].target = be16(&payload[4]) >> 1;
        ax[3].target = be16(&payload[6]) >> 1;
        /* Axes optionnels M5/M6 (regle AVR) :
           - attendre la fin du homing (sinon cible ignoree)
           - si max calibre : mapper 0..65535 -> [0, max - 2*margin]
             (le zero logique a deja consomme une margin au homing)
           - sinon : valeur brute (comportement AVR historique) */
        for (uint8_t i = 4; i < 6 && i < NUM_MOTORS; i++) {
          if (!axCfg[i].connected)            continue;
          if (!ax[i].homed || ax[i].homing)   continue;
          if (calibIsBusy(i))                 continue;
          uint16_t u = be16(&payload[2U * i]);
          if (axCfg[i].maxPos != 0U) {
            uint32_t twice = (uint32_t)axCfg[i].margin * 2UL;
            uint16_t hi = ((uint32_t)axCfg[i].maxPos > twice)
                        ? (uint16_t)((uint32_t)axCfg[i].maxPos - twice) : 0U;
            ax[i].target = (hi == 0U) ? 0U
                         : (uint16_t)(((uint32_t)u * hi) / 65535UL);
          } else {
            ax[i].target = u;
          }
        }
        s_pFrameApplied = true;
        stash_consume(13U);
        continue;
      }
      /* Trame incomplète : attendre la suite. Si plus rien n'arrive après
         20 ms, c'est peut-être une commande texte commençant par 'P' :
         laisser le chemin texte ci-dessous la traiter. */
      if ((HAL_GetTick() - s_lastRxTick) < 20U) break;
    }

    /* ===== Trames binaires legacy : 'S' + {A,T,C} ======================== */
    if (c0 == 'S') {
      if (s_len < 2U) break;

      uint8_t cmd = s_stash[1];

      if (cmd == 'A') {
        stash_consume(2U);
        for (uint8_t i = 0; i < NUM_MOTORS; i++) {
          ax[i].pos = 0U;
          ax[i].target   = 0U;
          s_lastStepUs[i] = 0U;
          s_dirV[i]       = 0;
        }
        simhubConnected = true;
        enableServo();
        cdc_send_str("OK\n");
        continue;
      }

      if (cmd == 'T') {
        if (s_len < 12U) break;
        bool valid = true;
        for (uint8_t m = 0; m < 5U; m++) {
          if (s_stash[2U + m * 2U] & 0x80U) { valid = false; break; }
        }
        if (!valid) { stash_consume(1U); continue; }
        const uint8_t *payload = &s_stash[2];
        ax[0].target = be16(&payload[0]);
        ax[1].target = be16(&payload[2]);
        ax[2].target = be16(&payload[4]);
        ax[3].target = be16(&payload[6]);
        stash_consume(12U);
        continue;
      }

      if (cmd == 'C') {
        stash_consume(2U);
        simhubConnected = false;
        for (uint8_t i = 0; i < NUM_MOTORS; i++) ax[i].target = 0U;
        s_pendingDisable = true;
        continue;
      }
      /* 'S' + autre chose (SH_*, SET…) : ligne texte, chemin ci-dessous. */
    }

    /* ===== Commandes texte (SimHub handshake / Motion Center) ============ */
    if (c0 < 0x20 || c0 > 0x7E) { stash_consume(1U); continue; }

    uint16_t nl = 0U;
    bool eol = false;
    while (nl < s_len) {
      uint8_t c = s_stash[nl];
      if (c == '\n' || c == '\r') { eol = true; break; }
      nl++;
    }
    if (!eol) {
      /* SimHub n'envoie AUCUN terminateur (SH_CONNECTED, SH_START…).
         Repli : si plus rien n'arrive depuis 20 ms, traiter le stash
         entier comme une ligne complète. */
      if ((HAL_GetTick() - s_lastRxTick) < 20U) {
        if (s_len >= (uint16_t)(STASH_SIZE - 1U)) s_len = 0U;
        break;
      }
      nl = s_len;   /* ligne = tout le contenu, sans terminateur */
    }

    char line[48];
    uint16_t n = nl;
    if (n > (uint16_t)(sizeof(line) - 1U)) n = (uint16_t)(sizeof(line) - 1U);
    memcpy(line, s_stash, n);
    line[n] = '\0';

    /* Consommer la ligne + terminateur(s) s'il y en a. */
    uint16_t adv = nl;
    if (eol) {
      adv++;
      if (adv < s_len && (s_stash[adv] == '\n' || s_stash[adv] == '\r')) adv++;
    }
    stash_consume(adv);

    handleTextCommand(line);
  }
}
/* USER CODE END 0 */

/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_USB_DEVICE_Init();
  /* USER CODE BEGIN 2 */
  /* MX_USB_DEVICE_Init() initialise déjà la pile USB CDC (USBD_Init,
     USBD_RegisterClass, USBD_CDC_RegisterInterface, USBD_Start). */
  MX_TIM2_Init();       /* TIM2 : free-running 1 MHz counter pour delay_us() */
  actuatorConfigInit(); /* peuple ax[]/axCfg[] pour les 4 axes */
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
	  axMicros();               /* entretient le compteur µs 32 bits (anti-wrap TIM2) */
	  SerialReaderP();          /* traite le stash USB (SH_START, ST, etc.) */
	  homingTick();             /* FSM homing MIN M5/M6 (non bloquant) */
	  calibTick();              /* FSM calibration complete (non bloquant) */
	  serviceCalibReply();      /* OK/ERR differe en fin de calibration */

	  /* Regle AVR : geler M1-M4 pendant le homing/calib M5/M6, et jusqu'a
	     la premiere frame P appliquee apres la fin (anti a-coup). */
	  {
	    const bool busy56 = homingIsActive(4) || homingIsActive(5)
	                     || calibIsBusy(4)    || calibIsBusy(5);
	    if (busy56) { s_holdBaseAxes = true; s_pFrameApplied = false; }
	    else if (s_holdBaseAxes && s_pFrameApplied) s_holdBaseAxes = false;
	    if (busy56 || s_holdBaseAxes) {
	      for (uint8_t i = 0; i < 4U; i++) ax[i].target = ax[i].pos;
	    }
	  }
	  stepDirServiceFastV2();   /* génère les pas vers ax[].target */
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */

  }
  /* USER CODE END 3 */
}

